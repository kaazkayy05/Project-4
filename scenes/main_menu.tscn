[node name="ExplanationText" type="Label" parent="Center/SettingsPanel/Margin/VBox" unique_id=194820107]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.78, 0.88, 1)
theme_override_font_sizes/font_size = 11
text = "WHAT SETTINGS & SOUND DO:
• Sensitivity: Adjusts microphone gain. Higher sensitivity detects quieter speech; lower sensitivity requires louder sound.
• Recalibrate: Automatically measures background room noise and tunes sensitivity so ambient room hum won't trigger jumps.
• Yapping: Speak into your mic to walk upright.
• Silence (5s on ground): Puts you into a crouchwalk.
• Scream Jump: Shout to jump (unlocked in Level 4 with live dBFS meter). Requires 0.1s quiet between jumps.
• Karma Warning: Screaming within 3m of an interactable costs 10 Karma!"
autowrap_mode = 2

